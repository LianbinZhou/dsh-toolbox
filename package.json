{
  "name": "dsh-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One container for the personal DSH plugin set: one row, one settings card, one switch per feature",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test test/",
    "prepack": "node tools/build.mjs && node --test test/"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
